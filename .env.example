# Copy to .env and fill in real values. Never commit .env.

# --- Local development (dotnet run) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=stockify;Username=postgres;Password=change-me

# At least 32 random characters, e.g. `openssl rand -base64 48`
JwtSettings__Key=change-me-to-a-long-random-secret-at-least-32-bytes

# First platform admin, created on startup when none exists yet.
# Used with POST /api/platform/auth/login to create and manage companies.
PlatformAdmin__Email=you@example.com
PlatformAdmin__Password=change-me-too

# --- docker compose ---
POSTGRES_DB=stockify
POSTGRES_USER=stockify
POSTGRES_PASSWORD=change-me
